# Copy next to deploy/compose.yml on the server as .env, then: chmod 600 .env

# Only used on the very first start; you must change the password on first login.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-on-first-login

# The docker group's id on the server: getent group docker | cut -d: -f3
DOCKER_GID=999

# The folder that holds one subfolder per compose stack, e.g. /home/you/services.
# It must be writable by the app's user (uid 10001) for stacks created in the app.
STACKS_DIR=/home/you/services
